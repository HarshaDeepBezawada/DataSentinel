# ==========================================
# DataSentinel Environment Configuration
# ==========================================
# Copy this file to .env and configure local credentials.
# NEVER commit the real .env file with secrets to version control.

# Database Credentials (PostgreSQL / Relational)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=analytics_db
DB_USER=postgres_user
DB_PASSWORD=your_secure_database_password_here

# REST API Authentication
API_BEARER_TOKEN=your_jwt_or_bearer_token_here
API_KEY=your_x_api_key_here

# Alerting: SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASSWORD=your_smtp_app_password_here

# Alerting: Slack Webhook Configuration
SLACK_WEBHOOK_URL=https://your-slack-webhook-url-here
